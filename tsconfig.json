{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": false,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "noFallthroughCasesInSwitch": false,

    "strictBindCallApply": true,
    "strictFunctionTypes": false,
    "useUnknownInCatchVariables": true,
    "strictNullChecks": false,

    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "paths": {
      "@packages/berish-configurator-core": ["packages/berish-configurator-core/src"],
      "@packages/berish-configurator-env": ["packages/berish-configurator-env/src"],
      "@packages/berish-connector-pubsub": ["packages/berish-connector-pubsub/src"],
      "@packages/berish-context": ["packages/berish-context/src"],
      "@packages/berish-rpc-axios": ["packages/berish-rpc-axios/src"],
      "@packages/berish-rpc-client": ["packages/berish-rpc-client/src"],
      "@packages/berish-rpc-client-schema": ["packages/berish-rpc-client-schema/src"],
      "@packages/berish-rpc-express": ["packages/berish-rpc-express/src"],
      "@packages/berish-rpc-logger": ["packages/berish-rpc-logger/src"],
      "@packages/berish-rpc-nats": ["packages/berish-rpc-nats/src"],
      "@packages/berish-rpc-router": ["packages/berish-rpc-router/src"],
      "@packages/berish-rpc-server": ["packages/berish-rpc-server/src"],
      "@packages/berish-scheduler": ["packages/berish-scheduler/src"],
      "@packages/berish-scheduler-bull-adapter": ["packages/berish-scheduler-bull-adapter/src"],
      "@packages/berish-scheduler-cron-adapter": ["packages/berish-scheduler-cron-adapter/src"],

      "@ddd/application": ["packages/ddd/application/src"],
      "@ddd/core": ["packages/ddd/core/src"],
      "@ddd/domain": ["packages/ddd/domain/src"],
      "@ddd/errors": ["packages/ddd/errors/src"],
      "@ddd/events": ["packages/ddd/events/src"],
      "@ddd/infra": ["packages/ddd/infra/src"],
      "@ddd/specifications": ["packages/ddd/specifications/src"],
      "@ddd/validation": ["packages/ddd/validation/src"],

      "@packages/nestjs-connector-pubsub": ["packages/nestjs-connector-pubsub/src"],
      "@packages/nestjs-connector-pubsub-kafka-adapter": ["packages/nestjs-connector-pubsub-kafka-adapter/src"],
      "@packages/nestjs-request-context": ["packages/nestjs-request-context/src"],
      "@packages/nestjs-rpc-server": ["packages/nestjs-rpc-server/src"],
      "@packages/nestjs-scheduler": ["packages/nestjs-scheduler/src"],
      "@packages/nestjs-shutdown-hooks": ["packages/nestjs-shutdown-hooks/src"],

      "@shared/common-internal": ["shared/common-internal/src"],
      "@shared/config": ["shared/config/src"],
      "@shared/connectors": ["shared/connectors/src"],
      "@shared/db": ["shared/db/src"],
      "@shared/events": ["shared/events/src"],
      "@shared/utils": ["shared/utils/src"],
      "@shared/validation": ["shared/validation/src"],

      "@schema/common": ["shared/schema/common/src"],
      "@schema/core": ["shared/schema/core/src"],
      "@schema/desk-gateway": ["shared/schema/desk-gateway/src"],
      "@schema/file-management": ["shared/schema/file-management/src"],
      "@schema/lot-management": ["shared/schema/lot-management/src"],
      "@schema/note": ["shared/schema/note/src"],
      "@schema/notification": ["shared/schema/notification/src"],
      "@schema/tg-gateway": ["shared/schema/tg-gateway/src"],
      "@schema/user-identity": ["shared/schema/user-identity/src"],
      "@schema/feedback": ["shared/schema/feedback/src"]
    }
  }
}
