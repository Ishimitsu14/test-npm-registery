{
  "name": "deals-backend",
  "version": "0.7.0",
  "description": "",
  "author": "Ravil Berish",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "clean": "rm -f tsconfig.tsbuildinfo && rm -rf dist",
    "clean:service": "f() { rm -rf dist/services/\"$1\"; }; f",
    "clean:full": "rm -rf node_modules && rm -f yarn.lock && npm run clean",
    "service:dev": "f() { yarn clean:service \"$1\"; cross-env NODE_ENV=development nest start --watch @services/\"$1\"; }; f",
    "service:build": "f() { yarn clean:service \"$1\"; cross-env NODE_ENV=production nest build @services/\"$1\"; }; f",
    "service:start": "f() { yarn clean:service \"$1\"; cross-env NODE_ENV=production nest start @services/\"$1\"; }; f",
    "service:debug": "f() { yarn clean:service \"$1\"; cross-env NODE_ENV=development nest start --debug --watch @services/\"$1\"; }; f",
    "lint": "eslint \"**/*.+(ts|json|css|md)\"",
    "lint:fix": "yarn lint --fix",
    "prettier": "prettier --write \"**/*.+(ts|json|css|md)\"",
    "format": "yarn prettier && yarn lint:fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "precommit": "lint-staged",
    "prepare": "npx husky install",
    "typecheck": "tsc --noEmit",
    "mikro-orm": "cross-env MIKRO_ORM_ENV=mikro node -r tsconfig-paths/register -r ts-node/register node_modules/.bin/mikro-orm",
    "db:generate": "f() { yarn mikro-orm migration:create --config ./services/\"$1\"/mikro/config.ts; }; f",
    "db:up": "f() { yarn mikro-orm migration:up --config ./services/\"$1\"/mikro/config.ts; }; f",
    "db:down": "f() { yarn mikro-orm migration:down --config ./services/\"$1\"/mikro/config.ts; }; f",
    "db:list": "f() { yarn mikro-orm migration:list --config ./services/\"$1\"/mikro/config.ts; }; f",
    "db:check": "f() { yarn mikro-orm migration:check --config ./services/\"$1\"/mikro/config.ts;  }; f"
  },
  "lint-staged": {
    "**/*.+(ts|json|css|md)": [
      "npm run format"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run precommit"
    }
  },
  "resolutions": {
    "@types/mime": "3.0.4"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.423.0",
    "@berish/class": "^1.0.2",
    "@berish/linq": "^1.2.0",
    "@bull-board/express": "^5.14.2",
    "@faker-js/faker": "^8.0.2",
    "@mikro-orm/cli": "6.1.12",
    "@mikro-orm/core": "6.1.12",
    "@mikro-orm/migrations": "6.1.12",
    "@mikro-orm/postgresql": "6.1.12",
    "@mikro-orm/reflection": "6.1.12",
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.1.0",
    "@nestjs/microservices": "^10.1.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.1.0",
    "@prisma/client": "^5.0.0",
    "axios": "^1.4.0",
    "bullmq": "^5.4.2",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "crypto-js": "^4.1.1",
    "date-fns": "^3.3.1",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.3.1",
    "dotenv-expand": "^10.0.0",
    "ethers": "^6.6.5",
    "file-type": "16.5.3",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.1",
    "kafkajs": "^2.2.4",
    "lodash.clonedeep": "^4.5.0",
    "mock-aws-s3": "^4.0.2",
    "nats": "^2.15.1",
    "nestjs-telegraf": "^2.7.0",
    "node-cron": "^3.0.3",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "siwe": "^2.1.4",
    "telegraf": "^4.15.3",
    "uuid": "^9.0.0",
    "wildcard": "^2.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@trivago/prettier-plugin-sort-imports": "^4.2.0",
    "@types/crypto-js": "^4.1.1",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/lodash.clonedeep": "^4.5.7",
    "@types/mock-aws-s3": "^2.6.3",
    "@types/multer": "^1.4.8",
    "@types/node": "^20.3.1",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^2.0.12",
    "@types/uuid": "^9.0.2",
    "@typescript-eslint/eslint-plugin": "^6.2.0",
    "@typescript-eslint/parser": "^6.2.0",
    "eslint": "^8.0.1",
    "eslint-config-prettier": "^8.8.0",
    "eslint-config-standard-with-typescript": "^37.0.0",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-json": "^3.1.0",
    "eslint-plugin-n": "^15.0.0 || ^16.0.0 ",
    "eslint-plugin-promise": "^6.0.0",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "eslint-plugin-unused-imports": "^3.0.0",
    "husky": "^8.0.3",
    "jest": "^29.5.0",
    "lint-staged": "^13.2.3",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "*"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
